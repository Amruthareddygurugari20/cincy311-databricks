{
  "name": "cincy311_daily_pipeline",
  "description": "Daily medallion refresh: bronze -> silver -> gold for Cincinnati 311 requests.",
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "America/New_York",
    "pause_status": "UNPAUSED"
  },
  "tags": { "project": "cincy311" },
  "tasks": [
    {
      "task_key": "bronze",
      "notebook_task": { "notebook_path": "__WORKSPACE_DIR__/01_bronze" },
      "timeout_seconds": 3600
    },
    {
      "task_key": "silver",
      "depends_on": [{ "task_key": "bronze" }],
      "notebook_task": { "notebook_path": "__WORKSPACE_DIR__/02_silver" },
      "timeout_seconds": 3600
    },
    {
      "task_key": "gold",
      "depends_on": [{ "task_key": "silver" }],
      "notebook_task": { "notebook_path": "__WORKSPACE_DIR__/03_gold" },
      "timeout_seconds": 3600
    }
  ]
}
